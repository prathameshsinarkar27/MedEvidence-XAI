# MedEvidence-XAI environment configuration 

# ---- Application ----
APP_NAME=MedEvidence-XAI
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_DIR=logs                   # set empty to disable file logging
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- PostgreSQL ----
# Used by docker-compose.yml to create the development database.
POSTGRES_USER=medevidence
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=medevidence
POSTGRES_PORT=5432

# Used by the backend and Alembic (SQLAlchemy URL, psycopg v3 driver).
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://medevidence:change_me_please@localhost:5432/medevidence

# ---- Frontend (Vite dev server) ----
# Where the dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000
