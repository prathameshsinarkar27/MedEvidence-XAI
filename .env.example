# MedEvidence-XAI environment configuration 

# ---- Application ----
APP_NAME=MedEvidence-XAI
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_DIR=logs                   # set empty to disable file logging
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- PostgreSQL ----
# Used by docker-compose.yml to create the development database.
POSTGRES_USER=medevidence
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=medevidence
POSTGRES_PORT=5432

# Used by the backend and Alembic (SQLAlchemy URL, psycopg v3 driver).
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://medevidence:change_me_please@localhost:5432/medevidence

# ---- Document upload ----
# Where uploaded PDFs are stored. Relative paths resolve against the repository root.
# The default location is git-ignored. Never point this at a directory that is committed.
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=25          # 1-200

# ---- PDF text extraction + OCR ----
# OCR needs the Tesseract program installed separately (it is not a Python package):
#   Ubuntu/Debian: sudo apt install tesseract-ocr   macOS: brew install tesseract
#   Windows: UB Mannheim installer, then set TESSERACT_CMD below.
# Leave TESSERACT_CMD empty when `tesseract` is on PATH.
TESSERACT_CMD=
OCR_LANGUAGES=eng              # e.g. eng+hin (each language needs its Tesseract data installed)
OCR_DPI=200                    # render resolution for OCR, 72-400
OCR_TIMEOUT_SECONDS=60         # per page
MIN_TEXT_CHARS_PER_PAGE=25     # pages with fewer non-whitespace characters are treated as having no text layer
MAX_PDF_PAGES=300              # documents with more pages are rejected at processing time


# ---- Tables and embedded images  ----
# Extracted images are written here (relative paths resolve against the repository root). Git-ignored by default.
IMAGE_DIR=data/images
AUTO_MULTIMODAL=true           # run table/image extraction automatically after text extraction
IMAGE_OCR=false                # also OCR text printed inside images (needs Tesseract; slower)
MIN_IMAGE_SIDE_PX=32           # images with a shorter side are skipped (icons, rules)
MAX_IMAGES_PER_DOCUMENT=200
MAX_TABLES_PER_DOCUMENT=500
MAX_IMAGE_BYTES=10485760       # an image bigger than this is listed as not extracted
MAX_IMAGE_PIXELS=50000000      # guard against decompression bombs
MAX_CELLS_PER_TABLE=5000       # a larger detected grid is reported, not stored
IMAGE_OCR_MIN_CHARS=10         # image OCR output shorter than this counts as "no text found"


# Clinical information extraction ----
AUTO_CLINICAL_EXTRACTION=true  # run automatically after text and table/image processing
MAX_EVIDENCE_PER_DOCUMENT=20000 # safety cap; reaching it is reported


# evidence index + semantic retrieval ----
# hashing = works offline, no download, but matches words/spellings only (NOT meaning).
# sentence-transformers = real semantic model: `pip install -r backend/requirements-embeddings.txt`; the model is
# downloaded once from the Hugging Face hub. After changing the backend/model run POST /api/evidence/index/rebuild.
EMBEDDING_BACKEND=hashing      # hashing | sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # a hub name or a local folder (sentence-transformers only)
EMBEDDING_DIMENSION=512        # hashing only
EMBEDDING_LOCAL_FILES_ONLY=false   # true = never download
EMBEDDING_BATCH_SIZE=64
VECTOR_BACKEND=faiss           # faiss | numpy (both exact)
AUTO_INDEX_EVIDENCE=true       # index automatically after clinical extraction
SEARCH_MAX_TOP_K=100


# ---- hybrid ranking: final_score = sum(weight * component), weights >= 0 ----
# Defaults were selected on the dev split of a small synthetic benchmark with the lexical (hashing) embedding.
# Re-tune with `python scripts/evaluate_retrieval.py` if you switch to sentence-transformers.
RANK_WEIGHT_SEMANTIC=0.85
RANK_WEIGHT_KEYWORD=0.0
RANK_WEIGHT_ENTITY=1.21
RANK_WEIGHT_TEMPORAL=1.38
RANK_WEIGHT_CONFIDENCE=0.0
RANK_WEIGHT_SOURCE=0.05
RANKING_CANDIDATE_POOL=100


# ---- evidence verification and conflict detection (docs/verification.md, docs/conflict-detection.md) ----
# evidence_score = weighted mean of the components that apply. These are engineering defaults chosen by
# reasoning, NOT tuned or calibrated on data: "Not yet evaluated."
VERIFY_WEIGHT_RELEVANCE=1.0
VERIFY_WEIGHT_ENTITY=1.5
VERIFY_WEIGHT_VALUE=0.5
VERIFY_WEIGHT_TEMPORAL=1.0
VERIFY_WEIGHT_CONFIDENCE=0.75
VERIFY_WEIGHT_SOURCE=0.75
VERIFY_WEIGHT_DIRECTNESS=2.0
VERIFY_WEIGHT_AGREEMENT=0.5
VERIFY_SUPPORTED_SCORE=0.70        # evidence_score for an item to count as supporting
VERIFY_MIN_RELEVANT_SCORE=0.35     # below this an item is excluded
VERIFY_MIN_SEMANTIC_NO_ENTITY=0.30 # question without a recognised entity: minimum semantic similarity
VERIFY_UNDATED_TEMPORAL_SCORE=0.25 # temporal consistency of undated evidence under a time-constrained question
VERIFY_CANDIDATES=30               # evidence items retrieved per question
# Largest relative difference still called "measurement variation" (same or unknown time). Not clinical thresholds.
CONFLICT_TOLERANCE_LAB=0.05
CONFLICT_TOLERANCE_VITAL=0.10
CONFLICT_TOLERANCE_MEDICATION=0.0
CONFLICT_TOLERANCE_DEFAULT=0.05


# ---- Frontend (Vite dev server) ----
# Where the dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000
