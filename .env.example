# MedEvidence-XAI environment configuration 

# ---- Application ----
APP_NAME=MedEvidence-XAI
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_DIR=logs                   # set empty to disable file logging
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- PostgreSQL ----
# Used by docker-compose.yml to create the development database.
POSTGRES_USER=medevidence
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=medevidence
POSTGRES_PORT=5432

# Used by the backend and Alembic (SQLAlchemy URL, psycopg v3 driver).
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://medevidence:change_me_please@localhost:5432/medevidence

# ---- Document upload ----
# Where uploaded PDFs are stored. Relative paths resolve against the repository root.
# The default location is git-ignored. Never point this at a directory that is committed.
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=25          # 1-200

# ---- PDF text extraction + OCR ----
# OCR needs the Tesseract program installed separately (it is not a Python package):
#   Ubuntu/Debian: sudo apt install tesseract-ocr   macOS: brew install tesseract
#   Windows: UB Mannheim installer, then set TESSERACT_CMD below.
# Leave TESSERACT_CMD empty when `tesseract` is on PATH.
TESSERACT_CMD=
OCR_LANGUAGES=eng              # e.g. eng+hin (each language needs its Tesseract data installed)
OCR_DPI=200                    # render resolution for OCR, 72-400
OCR_TIMEOUT_SECONDS=60         # per page
MIN_TEXT_CHARS_PER_PAGE=25     # pages with fewer non-whitespace characters are treated as having no text layer
MAX_PDF_PAGES=300              # documents with more pages are rejected at processing time

# ---- Frontend (Vite dev server) ----
# Where the dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000
